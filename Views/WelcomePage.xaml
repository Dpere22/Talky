<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Talky.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="520"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <Border
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="44">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE8BD;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Welcome to Talky" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Chat, call and share your screen with friends on your local network. No servers, no accounts — just add a friend by their IP address."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />

            <Border Margin="0,8,0,0" Padding="16" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE909;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Your address" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Me.AddressText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyMyAddressCommand}"
                        Content="Copy" />
                </Grid>
            </Border>

            <Button
                HorizontalAlignment="Center"
                AutomationProperties.Name="Add a friend"
                Command="{x:Bind ViewModel.AddFriendCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                    <TextBlock Text="Add a friend" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
