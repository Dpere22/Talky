<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Talky.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Talky.Views.Controls"
    xmlns:helpers="using:Talky.Helpers"
    xmlns:vm="using:Talky.ViewModels"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!--  Discord-style message: avatar + name + time on the first message of a group, text only after.  -->
        <DataTemplate x:Key="TextMessageTemplate" x:DataType="vm:MessageViewModel">
            <StackPanel>
                <Grid
                    Margin="0,18,0,6"
                    ColumnSpacing="12"
                    Visibility="{x:Bind ShowDateDivider}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DateDividerText}" />
                    <Rectangle
                        Grid.Column="2"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>

                <Grid Padding="0,2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AvatarView
                        Margin="0,4,0,0"
                        VerticalAlignment="Top"
                        DisplayName="{x:Bind Author.DisplayName, Mode=OneWay}"
                        Size="40"
                        Visibility="{x:Bind IsGroupStart}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind IsGroupStart}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Author.DisplayName, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,0,0,1"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind TimeText}" />
                        </StackPanel>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                            <FontIcon
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE823;"
                                ToolTipService.ToolTip="Not delivered yet — it will be sent when they're online"
                                Visibility="{x:Bind IsPending, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CallEventTemplate" x:DataType="vm:MessageViewModel">
            <StackPanel>
                <Grid
                    Margin="0,18,0,6"
                    ColumnSpacing="12"
                    Visibility="{x:Bind ShowDateDivider}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DateDividerText}" />
                    <Rectangle
                        Grid.Column="2"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>
                <Grid Padding="0,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE717;"
                        Visibility="{x:Bind IsMissedCall}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE717;"
                        Visibility="{x:Bind helpers:Ui.Collapsed(IsMissedCall)}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Text}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind TimeText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <controls:MessageTemplateSelector
            x:Key="MessageTemplateSelector"
            CallEventTemplate="{StaticResource CallEventTemplate}"
            TextTemplate="{StaticResource TextMessageTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{x:Bind helpers:Ui.CallRowHeight(ViewModel.IsCallHere, ViewModel.Call.IsRemoteSharing), Mode=OneWay}" />
            <RowDefinition Height="{x:Bind helpers:Ui.MessagesRowHeight(ViewModel.IsCallHere, ViewModel.Call.IsRemoteSharing), Mode=OneWay}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Padding="20,10,12,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:AvatarView
                VerticalAlignment="Center"
                DisplayName="{x:Bind ViewModel.Friend.DisplayName, Mode=OneWay}"
                IsOnline="{x:Bind ViewModel.Friend.IsOnline, Mode=OneWay}"
                ShowPresence="True"
                Size="36" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    FontSize="18"
                    Text="{x:Bind ViewModel.Friend.DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind helpers:Ui.FriendStatusLine(ViewModel.Friend.StatusText, ViewModel.Friend.Address), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Friend.RemoteNameHint, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="Start voice call"
                    Command="{x:Bind ViewModel.StartCallCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Start voice call"
                    Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.IsCallHere), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE717;" />
                </Button>
                <Button
                    AutomationProperties.Name="More options"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.EditCommand}" Text="Edit nickname or address">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyAddressCommand}" Text="Copy address">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RemoveCommand}" Text="Remove friend">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Unknown peer that reached out  -->
        <InfoBar
            Grid.Row="1"
            Margin="16,12,16,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Friend.IsPending, Mode=OneWay}"
            Message="{x:Bind helpers:Ui.PendingFriendText(ViewModel.Friend.DisplayName, ViewModel.Friend.Address), Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.AcceptFriendCommand}" Content="Add to friends" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Call (Discord DM style: sits on top of the conversation)  -->
        <controls:CallPanel
            Grid.Row="2"
            Margin="16,12,16,4"
            Call="{x:Bind ViewModel.Call}"
            Friend="{x:Bind ViewModel.Friend}"
            Me="{x:Bind ViewModel.Me}"
            Visibility="{x:Bind ViewModel.IsCallHere, Mode=OneWay}" />

        <!--  Messages  -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="MessageList"
                Padding="0,0,0,8"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Messages}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="20,0,20,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <controls:AvatarView
                    HorizontalAlignment="Center"
                    DisplayName="{x:Bind ViewModel.Friend.DisplayName, Mode=OneWay}"
                    Size="72" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Friend.DisplayName, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind helpers:Ui.BeginningText(ViewModel.Friend.DisplayName), Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!--  Typing / offline hint  -->
        <StackPanel Grid.Row="4" Margin="24,0,24,2">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind helpers:Ui.TypingText(ViewModel.Friend.DisplayName), Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Friend.IsTyping, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind helpers:Ui.OfflineHint(ViewModel.Friend.DisplayName), Mode=OneWay}"
                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.Friend.IsOnline), Mode=OneWay}" />
        </StackPanel>

        <!--  Composer  -->
        <Grid
            Grid.Row="5"
            Margin="16,4,16,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Composer"
                MaxHeight="200"
                AcceptsReturn="True"
                AutomationProperties.Name="Message"
                MaxLength="{x:Bind ViewModel.MaxMessageLength}"
                PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder, Mode=OneWay}"
                PreviewKeyDown="OnComposerPreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                Height="32"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Send"
                Command="{x:Bind ViewModel.SendCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Send (Enter)">
                <FontIcon FontSize="14" Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</Page>
