<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Talky.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Talky.Views.Controls"
    xmlns:helpers="using:Talky.Helpers"
    xmlns:vm="using:Talky.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============================== Sidebar ==============================  -->
        <Grid x:Name="Sidebar">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="20,4,10,6">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Friends" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Add friend"
                    Command="{x:Bind ViewModel.AddFriendCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Add friend">
                    <FontIcon FontSize="16" Glyph="&#xE8FA;" />
                </Button>
            </Grid>

            <ListView
                x:Name="FriendList"
                Grid.Row="1"
                Padding="4,0"
                AutomationProperties.Name="Friends"
                ItemsSource="{x:Bind ViewModel.Friends}"
                SelectedItem="{x:Bind ViewModel.SelectedFriend, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendViewModel">
                        <Grid Padding="2,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnCallFriendClick" Text="Call">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE717;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnEditFriendClick" Text="Edit">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnRemoveFriendClick" Text="Remove">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <controls:AvatarView
                                DisplayName="{x:Bind DisplayName, Mode=OneWay}"
                                IsOnline="{x:Bind IsOnline, Mode=OneWay}"
                                ShowPresence="True"
                                Size="36" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Subtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE717;"
                                    Visibility="{x:Bind IsInCall, Mode=OneWay}" />
                                <InfoBadge Value="{x:Bind UnreadBadgeValue, Mode=OneWay}" Visibility="{x:Bind HasUnread, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Empty state  -->
            <StackPanel
                Grid.Row="1"
                Margin="24"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasFriends), Mode=OneWay}">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE716;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No friends yet. Add one by their IP address."
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.AddFriendCommand}"
                    Content="Add a friend"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!--  Voice connected banner (visible from any page while in a call)  -->
            <Border
                Grid.Row="2"
                Margin="8,4,8,0"
                Padding="12,8,6,8"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind ViewModel.Call.IsInCall, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ShowCallFriendCommand}"
                        ToolTipService.ToolTip="Go to call">
                        <StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.Call.BannerTitle, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Call.BannerSubtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Hang up"
                        Command="{x:Bind ViewModel.Call.HangUpCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Hang up">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE778;" />
                    </Button>
                </Grid>
            </Border>

            <!--  User panel  -->
            <Grid
                Grid.Row="3"
                Margin="8"
                Padding="8,6,4,6"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AvatarView
                    VerticalAlignment="Center"
                    DisplayName="{x:Bind ViewModel.Me.DisplayName, Mode=OneWay}"
                    IsOnline="True"
                    ShowPresence="True"
                    Size="34" />
                <Button
                    Grid.Column="1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CopyMyAddressCommand}"
                    ToolTipService.ToolTip="Click to copy your address">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Me.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Me.AddressText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2">
                    <ToggleButton
                        AutomationProperties.Name="Mute"
                        IsChecked="{x:Bind ViewModel.Call.IsMuted, Mode=TwoWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind helpers:Ui.MuteToolTip(ViewModel.Call.IsMuted), Mode=OneWay}">
                        <controls:SlashedGlyph Glyph="&#xE720;" IsSlashed="{x:Bind ViewModel.Call.IsMuted, Mode=OneWay}" />
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="Deafen"
                        IsChecked="{x:Bind ViewModel.Call.IsDeafened, Mode=TwoWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind helpers:Ui.DeafenToolTip(ViewModel.Call.IsDeafened), Mode=OneWay}">
                        <controls:SlashedGlyph Glyph="&#xE7F6;" IsSlashed="{x:Bind ViewModel.Call.IsDeafened, Mode=OneWay}" />
                    </ToggleButton>
                    <Button
                        AutomationProperties.Name="Settings"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ============================== Content ==============================  -->
        <Grid
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                Margin="16,12,16,0"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasNetworkError, Mode=OneWay}"
                Message="{x:Bind ViewModel.NetworkError, Mode=OneWay}"
                Severity="Error"
                Title="Friends can't reach you" />
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>

        <!--  ============================== Incoming call card ==============================  -->
        <Border
            Grid.ColumnSpan="2"
            Width="340"
            Margin="0,16,0,0"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Shadow="{StaticResource CardShadow}"
            Translation="0,0,32"
            Visibility="{x:Bind ViewModel.Call.IsIncomingRinging, Mode=OneWay}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <controls:AvatarView DisplayName="{x:Bind ViewModel.Call.FriendName, Mode=OneWay}" Size="56" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Call.FriendName, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Incoming voice call" />
                    </StackPanel>
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:TintedButton
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Decline call"
                        Command="{x:Bind ViewModel.Call.DeclineCommand}"
                        Tint="Danger">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE778;" />
                            <TextBlock Text="Decline" />
                        </StackPanel>
                    </controls:TintedButton>
                    <controls:TintedButton
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Accept call"
                        Command="{x:Bind ViewModel.Call.AcceptCommand}"
                        Tint="Success">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE717;" />
                            <TextBlock Text="Accept" />
                        </StackPanel>
                    </controls:TintedButton>
                </Grid>
            </StackPanel>
        </Border>

        <!--  ============================== Theater (full-window shared screen) ==============================  -->
        <Grid
            Grid.ColumnSpan="2"
            Background="Black"
            Visibility="{x:Bind ViewModel.Call.IsTheaterMode, Mode=OneWay}">
            <controls:RemoteScreenView Source="{x:Bind ViewModel.Call.RemoteScreen}" />
            <Button
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Exit full screen"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                Command="{x:Bind ViewModel.Call.ExitTheaterCommand}"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Exit full screen (Esc)">
                <FontIcon FontSize="16" Glyph="&#xE73F;" />
            </Button>
        </Grid>
    </Grid>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="OnEscapeInvoked" Key="Escape" />
    </Page.KeyboardAccelerators>
</Page>
