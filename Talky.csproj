<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 24H2 (build 26100) or later only; keep in sync with MinVersion in Package.appxmanifest
         and the startup check in App.xaml.cs (unpackaged builds don't enforce the manifest). -->
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>Talky</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed for the audio/video interop hot paths (IMemoryBufferByteAccess, D3D11 device creation, RNNoise). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep in sync with Identity Version in Package.appxmanifest. -->
    <Version>1.1.0</Version>
    <!-- Program.cs owns Main so Velopack's install/update hooks run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <!-- Loaded at runtime (title bar / window icon), so portable builds need it next to the exe. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.

    Versions are pinned (instead of floating "*") so builds stay reproducible.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!--
      Only the Windows App SDK components Talky uses, instead of the Microsoft.WindowsAppSDK
      metapackage (which also pulls in AI, ML/ONNX Runtime + DirectML, Search, Widgets and DWriteCore,
      ~50 MB of unused DLLs in self-contained builds). Keep the three versions identical.
        Foundation: app notifications, app lifecycle, MRT resources (brings InteractiveExperiences + Base).
        WinUI:      XAML.
        Runtime:    framework package reference for packaged (MSIX / F5) builds.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <!--
      The Community Toolkit packages depend on the metapackage (>= 1.6), which would bring every component back.
      Pin it to the same version and exclude the components Talky doesn't use: a direct reference's
      ExcludeAssets wins over the transitive path, so none of their DLLs or build logic reach the app.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <!-- Installer + updates from GitHub Releases (build-release.ps1). Keep in sync with vpk in dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <!-- Opus voice codec, fully managed (BSD-3). -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!--
      Native RNNoise (Xiph, BSD-3) binary for win-x64. We only consume the native
      rnnoise.dll and P/Invoke it ourselves (Services/Audio/RnNoise.cs), so the managed wrapper
      is excluded. On ARM64 there is no binary: noise suppression reports itself unavailable.
    -->
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" IncludeAssets="native" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Self-contained publishes (MSIX) only: build-release.ps1 overrides this, since trimming needs a self-contained .NET. -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Precompile Talky's own code (and Concentus etc.) for fast startup, but not the big WinRT projections:
      ReadyToRun more than doubles them (+12 MB, mostly Microsoft.WinUI.dll) and only a small part of them runs.
    -->
    <PublishReadyToRunExclude Include="Microsoft.WinUI.dll;Microsoft.InteractiveExperiences.Projection.dll;Microsoft.Web.WebView2.Core.Projection.dll" />
  </ItemGroup>
</Project>
