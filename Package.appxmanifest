<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap10 rescap com desktop">

  <!--
    Publisher must equal the subject of the certificate that signs the MSIX (see build-msix.ps1).
    Note: Windows refuses unsigned MSIX packages that contain an app executable, so unsigned
    builds for friends use build-portable.ps1 instead. Bump Version for every MSIX you hand out.
  -->
  <Identity
    Name="0ee22b0a-0778-48f7-a42e-ea98989c5326"
    Publisher="CN=dpuu2"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="0ee22b0a-0778-48f7-a42e-ea98989c5326" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Talky</DisplayName>
    <PublisherDisplayName>dpuu2</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <!-- Windows 11 24H2 or later (keep in sync with TargetPlatformMinVersion in Talky.csproj). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Talky"
        Description="Peer-to-peer LAN text chat, voice calls and screen sharing."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- App notifications (message / incoming call toasts) activate the app through this COM server. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="6D3C2B7E-58A1-4F0B-9E2D-71C4A8F35B90" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Talky.exe" Arguments="----AppNotificationActivated:" DisplayName="Talky notifications">
              <com:Class Id="6D3C2B7E-58A1-4F0B-9E2D-71C4A8F35B90" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
